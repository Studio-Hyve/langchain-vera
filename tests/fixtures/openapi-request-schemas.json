     "query": "best specialty coffee roasters in dubai",
     "brand": "Roasters",
     "domain": "roasters.ae",
     "location": "Dubai",
     "gl": "ae",
     "hl": "en",
     "depth": 30
    }
   },
   "knownFields": [
